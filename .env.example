# Public site origin — no trailing slash.
# Drives canonical URLs, Open Graph / Twitter tags, robots.txt, sitemap.xml,
# and JSON-LD structured data. Falls back to https://radarcharts.net when unset.
NEXT_PUBLIC_SITE_URL=https://radarcharts.net

# Optional public YouTube playlist ID for the persistent cross-page player.
# Leave blank to disable the player until the playlist is approved/configured.
NEXT_PUBLIC_YOUTUBE_PLAYLIST_ID=

# --- Server-only (no NEXT_PUBLIC_ prefix — never exposed to the browser) ---

# Optional upstream the /api/contact route forwards leads to (CRM / webhook).
# When unset, the route logs submissions server-side instead.
CONTACT_ENDPOINT=

# WordPress origin used by the server-only RADAR content bridge.
# The bridge reads public published content; admin editing remains in /wp-admin.
WORDPRESS_BASE_URL=https://radarcharts.net

# WordPress.com site slug used for the secondary publications archive.
WORDPRESS_COM_SITE=remradar.wordpress.com

# Native component replacement API write protection
NATIVE_ADMIN_TOKEN=replace-with-a-long-random-token
